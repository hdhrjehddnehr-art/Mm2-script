-- ===== BOTÃO LOCK AIM (pequeno, arrastável) =====
local btnAim = Instance.new("TextButton")
btnAim.Name = "BtnAim"
btnAim.Size = UDim2.new(0, 70, 0, 40)
btnAim.Position = UDim2.new(0, 20, 0.7, 0)
btnAim.BackgroundColor3 = Color3.fromRGB(60, 60, 200)
btnAim.Text = "AIM"
btnAim.TextSize = 15
btnAim.Font = Enum.Font.GothamBold
btnAim.TextColor3 = Color3.new(1, 1, 1)
btnAim.Parent = ScreenGui
Instance.new("UICorner", btnAim).CornerRadius = UDim.new(0, 10)

local dragging, ds, sp
btnAim.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        dragging, ds, sp = true, i.Position, btnAim.Position
    end
end)
btnAim.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local d = i.Position - ds
        btnAim.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
    end
end)

local posC
btnAim.MouseButton1Down:Connect(function() posC = btnAim.Position end)
btnAim.MouseButton1Up:Connect(function()
    if btnAim.Position == posC then
        aimAtivo = not aimAtivo
        if aimAtivo then
            btnAim.Text = "AIM ON"
            btnAim.BackgroundColor3 = Color3.fromRGB(60, 200, 100)
        else
            btnAim.Text = "AIM"
            btnAim.BackgroundColor3 = Color3.fromRGB(60, 60, 200)
        end
    end
end)

