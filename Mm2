-- ================= ESTADO =================
local espAtivo = false
local aimAtivo = false
local modoGun = "TELEPORT FLASH"  -- "TELEPORT FLASH" | "BRING GUN"
local Murder, Sheriff, Hero
local roles

-- ================= ESP =================
local function IsAlive(Player)
    if not roles then return false end
    for i, v in pairs(roles) do
        if Player.Name == i then
            return not v.Killed and not v.Dead
        end
    end
    return false
end

local function limparHighlights()
    for _, v in pairs(Players:GetChildren()) do
        if v.Character and v.Character:FindFirstChild("Highlight") then
            v.Character.Highlight:Destroy()
        end
    end
end

local function CreateHighlight()
    for _, v in pairs(Players:GetChildren()) do
        if v ~= LP and v.Character and not v.Character:FindFirstChild("Highlight") then
            Instance.new("Highlight", v.Character)
        end
    end
end

local function UpdateHighlights()
    for _, v in pairs(Players:GetChildren()) do
        if v ~= LP and v.Character then
            local Highlight = v.Character:FindFirstChild("Highlight")
            if Highlight then
                if v.Name == Murder and IsAlive(v) then
                    Highlight.FillColor = Color3.fromRGB(225, 0, 0)
                elseif v.Name == Sheriff and IsAlive(v) then
                    Highlight.FillColor = Color3.fromRGB(0, 0, 225)
                elseif v.Name == Hero and IsAlive(v) then
                    Highlight.FillColor = Color3.fromRGB(255, 250, 0)
                else
                    Highlight.FillColor = Color3.fromRGB(0, 225, 0)
                end
            end
        end
    end
end

-- ================= VISIBILIDADE (sem parede) =================
local function estaVisivel(alvoChar)
    local cam = workspace.CurrentCamera
    local hrp = alvoChar and alvoChar:FindFirstChild("HumanoidRootPart")
    local head = alvoChar and alvoChar:FindFirstChild("Head")
    if not hrp or not cam then return false end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LP.Character, alvoChar}

    local origem = cam.CFrame.Position
    local alvo = head and head.Position or hrp.Position
    local resultado = workspace:Raycast(origem, alvo - origem, params)
    return resultado == nil
end

-- ================= LOCK AIM FORTE =================
RunService.RenderStepped:Connect(function()
    pcall(function()
        local remoto = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
        if remoto then roles = remoto:InvokeServer() end
    end)
    if roles then
        for i, v in pairs(roles) do
            if v.Role == "Murderer" then Murder = i
            elseif v.Role == "Sheriff" then Sheriff = i
            elseif v.Role == "Hero" then Hero = i
            end
        end
    end

    if espAtivo then
        CreateHighlight()
        UpdateHighlights()
    end

    if aimAtivo and Murder then
        local alvo = Players:FindFirstChild(Murder)
        if alvo and alvo.Character and alvo.Character:FindFirstChild("HumanoidRootPart")
        and IsAlive(alvo) and estaVisivel(alvo.Character) then
            local cam = workspace.CurrentCamera
            local pos = alvo.Character.HumanoidRootPart.Position
            cam.CFrame = CFrame.lookAt(cam.CFrame.Position, pos)
        end
    end
end)

-- ================= GUN: 11 MAPAS =================
local listaGuns = {
    "Hotel", "House2", "Workplace", "Hospital3", "Bank2",
    "BioLab", "Mansion2", "ResearchFacility", "MilBase",
    "Factory", "PoliceStation",
}

local function acharGunDrop()
    for _, mapa in ipairs(listaGuns) do
        local m = workspace:FindFirstChild(mapa)
        if m then
            local gun = m:FindFirstChild("GunDrop")
            if gun then
                return gun, mapa
            end
        end
    end
    return nil, nil
end

-- ================= GUN v2: EXECUÇÃO =================
local function executarGun()
    local gunDrop, mapaAchado = acharGunDrop()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if not gunDrop or not hrp then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Gun v2"; Text = "GunDrop não achado em nenhum mapa!"; Duration = 3 })
        return
    end

    local posicaoOriginal = hrp.CFrame
    local destino = gunDrop.CFrame + Vector3.new(0, 3, 0)

    if modoGun == "TELEPORT FLASH" then
        -- ===== 1 TP PRA GUN + 1 TP DE VOLTA (mega rápido, sem passos) =====
        task.spawn(function()
            hrp.CFrame = destino                    -- 1º TP: vai pra gun
            task.wait(0.25)                          -- 0.25s segurando (pega a gun)
            hrp.CFrame = posicaoOriginal             -- 2º TP: volta pra posição
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Teleport Flash"; Text = "Gun ("..(mapaAchado or "?")..") pegada e voltou!"; Duration = 3 })
        end)

    elseif modoGun == "BRING GUN" then
        -- ===== A GUN VEM ATÉ VOCÊ (teleport gun) =====
        task.spawn(function()
            local meuChar = LP.Character
            local meuHRP = meuChar and meuChar:FindFirstChild("HumanoidRootPart")
            if not meuHRP then return end

            -- teleporta a gun pra cima de você
            gunDrop.CFrame = meuHRP.CFrame * CFrame.new(0, 2, -3)

            -- força o toque da gun em você (pega garantido)
            task.spawn(function()
                for i = 1, 10 do
                    pcall(function()
                        firetouchinterest(meuHRP, gunDrop, 0)
                        firetouchinterest(meuHRP, gunDrop, 1)
                    end)
                    task.wait(0.05)
                end
            end)

            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Bring Gun"; Text = "Gun ("..(mapaAchado or "?")..") trouxe até você!"; Duration = 3 })
        end)
    end
end

